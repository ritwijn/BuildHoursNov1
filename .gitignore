.env
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.streamlit/

# Stage artifacts: raw pages, chunks, embeddings and the manifest are committed as a
# snapshot for reviewers. Chroma is rebuilt locally with `python -m src.cli ingest --no-scrape`.
# Retrieval logs are runtime output; only the ones cited in Docs/sample_qa.md are force-added.
*.tmp
data/chroma/*
!data/chroma/.gitkeep
data/retrieval_logs/*
!data/retrieval_logs/.gitkeep
