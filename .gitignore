.env
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Stage artifacts (raw pages, chunks, embeddings, manifest) are committed so reviewers can
# inspect every stage. The Chroma store is not: it is rebuilt from the embeddings (ingest,
# or automatically when the API starts). Retrieval logs are runtime output; only the ones
# cited in Docs/sample_qa.md are force-added.
*.tmp
data/chroma/
data/retrieval_logs/*
!data/retrieval_logs/.gitkeep
