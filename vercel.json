{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__path=:path*"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{src/**,config/**,data/chroma/**,data/ingest_manifest.json,models/**}",
      "excludeFiles": "{.venv/**,tests/**,Docs/**,data/raw/**,data/chunks/**,data/embeddings/**,data/retrieval_logs/**,**/kubernetes/**,**/__pycache__/**}"
    }
  }
}
